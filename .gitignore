# ==========================================
# Python Virtual Environments
# ==========================================
myenv/
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
**/myenv/
**/venv/
**/.venv/

# ==========================================
# Byte-compiled / Cache / Build
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# ==========================================
# Jupyter Notebook Checkpoints & Cache
# ==========================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# Simulation Outputs & Videos
# (Preserve folder structure via .gitkeep)
# ==========================================
**/videos/*
!**/videos/.gitkeep
videos/*
!videos/.gitkeep
*.mp4
*.avi
*.webm

# ==========================================
# Microsoft Office / Temporary files
# ==========================================
~$*
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx
*.tmp
*.log

# ==========================================
# IDE & Code Editor Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
