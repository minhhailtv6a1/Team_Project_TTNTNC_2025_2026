{
  "contract": "caro-v2",
  "board_size": 11,
  "win_length": 5,
  "stone_format": "[row, col, player] với X=1, O=-1; board đặt trực tiếp (không cần xen kẽ lượt)",
  "expected_winner": "1 (X) | -1 (O) | null (chưa có người thắng, gồm cả hòa)",
  "test_cases": [
    {
      "id": "W2_WIN_H_X",
      "group": "WIN",
      "description": "X thắng ngang, hai đầu trống",
      "direction": "ngang",
      "pattern": ".XXXXX.",
      "stones": [[5, 3, 1], [5, 4, 1], [5, 5, 1], [5, 6, 1], [5, 7, 1]],
      "expected_winner": 1,
      "expected_terminated": true
    },
    {
      "id": "W2_WIN_H_O",
      "group": "WIN",
      "description": "O thắng ngang, hai đầu trống",
      "direction": "ngang",
      "pattern": ".OOOOO.",
      "stones": [[5, 3, -1], [5, 4, -1], [5, 5, -1], [5, 6, -1], [5, 7, -1]],
      "expected_winner": -1,
      "expected_terminated": true
    },
    {
      "id": "W2_WIN_V_X",
      "group": "WIN",
      "description": "X thắng dọc, hai đầu trống",
      "direction": "dọc",
      "pattern": ".XXXXX.",
